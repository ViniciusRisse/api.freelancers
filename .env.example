# Copie este arquivo para .env e preencha.

# Chave da API do Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Token de acesso do Freelancer.com (https://accounts.freelancer.com/settings/develop)
# Escopos necessários: basic + advanced (para enviar lances)
FREELANCER_TOKEN=

# Use https://www.freelancer-sandbox.com para testar sem enviar lances reais
FREELANCER_API=https://www.freelancer.com

PORT=3000

# Senha para abrir o site (recomendado se publicar na internet). Deixe vazio para uso local.
SENHA=
